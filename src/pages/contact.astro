---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";
import { FaAddressCard, FaEnvelope, FaPhoneAlt } from "react-icons/fa";

const entry = (await getEntry(
  "contact",
  "-index"
)) as CollectionEntry<"contact">;
const { address, email, phone } = config.contactinfo;
const { title, description, meta_title, image } = entry.data;
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <section class="section">
    <div class="container">
      <h1 set:html={markdownify(title)} class="h2 page-heading" />
      <div class="row md:gx-5 gy-5">
        <div class="sm:col-5 md:col-4">
          <p class="mb-8 text-2xl font-bold text-text-dark">Contact Info</p>
          <ul class="flex flex-col space-y-8">
            <!-- <li>
              <div class="flex text-text-dark items-center text-xl">
                <FaAddressCard className="mr-3 text-primary" />
                <p class="font-semibold">Address</p>
              </div>
              <p set:html={markdownify(address)} class="mt-2 leading-5 pl-8" />
            </li> -->
            <li>
              <div class="flex text-text-dark items-center text-xl">
                <FaEnvelope className="mr-3 text-primary" />
                <p class="font-semibold">Email</p>
              </div>
              <p
                set:html={markdownify(email)}
                class="mt-2 leading-5 pl-8 content"
              />
            </li>
            <!-- <li>
              <div class="flex text-text-dark items-center text-xl">
                <FaPhoneAlt className="mr-3 text-primary" />
                <p class="font-semibold">Phone</p>
              </div>
              <p set:html={markdownify(phone)} class="mt-2 leading-5 pl-8" />
            </li> -->
          </ul>
        </div>
        <div class="sm:col-7 md:col-8">
          <form
            class="contact-form row gy-2 justify-center"
            method="POST"
            action="/api/contact"
          >
            {/* honeypot: hidden from real visitors, bots often fill it in */}
            <input
              type="text"
              name="company"
              tabindex="-1"
              autocomplete="off"
              class="absolute left-[-9999px]"
              aria-hidden="true"
            />
            <div class="lg:col-6">
              <label class="mb-2 block" for="name"
                >Name <span class="text-red-600">*</span></label
              >
              <input
                class="form-input w-full"
                name="name"
                type="text"
                required
              />
            </div>
            <div class="lg:col-6">
              <label class="mb-2 block" for="email"
                >Email <span class="text-red-600">*</span></label
              >
              <input
                class="form-input w-full"
                name="email"
                type="email"
                required
              />
            </div>
            <div class="col-12">
              <label class="mb-2 block" for="subject">Subject</label>
              <input class="form-input w-full" name="subject" type="text" />
            </div>
            <div class="col-12">
              <label class="mb-2 block" for="message"
                >Message <span class="text-red-600">*</span></label
              >
              <textarea
                class="form-textarea w-full"
                name="message"
                rows="4"
                required
              />
            </div>
            <div class="col-12">
              <button class="btn btn-primary mt-2">Submit Now</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <dialog
    id="contact-modal"
    class="m-auto w-[90%] max-w-md rounded-lg border border-border bg-body p-8 text-center text-text backdrop:bg-black/60"
  >
    <h3 id="contact-modal-title" class="mb-4"></h3>
    <p id="contact-modal-text" class="mb-6"></p>
    <form method="dialog">
      <button class="btn btn-primary">Close</button>
    </form>
  </dialog>
</Base>

<script is:inline define:vars={{ contactEmail: email }}>
  // The page is prerendered, so the result can't be rendered server-side from
  // ?status=. The form is submitted with fetch so the visitor stays on the
  // page (and keeps their typed message if it fails); the redirect target's
  // ?status= is read from the final response URL. The ?status= check on load
  // covers a plain (non-JS) form POST that lands back here.
  (function () {
    var messages = {
      success: {
        title: "Message sent",
        text: "Thanks for reaching out! I'll get back to you soon.",
        ok: true,
      },
      "invalid-email": {
        title: "Check your email address",
        text: "That email address doesn't look valid. Please check it and try again.",
        ok: false,
      },
      error: {
        title: "Something went wrong",
        text:
          "Your message couldn't be sent. Please try again, or email " +
          contactEmail +
          " directly.",
        ok: false,
      },
    };

    function init() {
      var form = document.querySelector("form.contact-form");
      var modal = document.getElementById("contact-modal");
      if (!form || !modal) return;

      function show(status) {
        var m = messages[status] || messages.error;
        var title = document.getElementById("contact-modal-title");
        title.textContent = m.title;
        title.classList.toggle("text-primary", m.ok);
        title.classList.toggle("text-red-600", !m.ok);
        document.getElementById("contact-modal-text").textContent = m.text;
        if (!modal.open) modal.showModal();
      }

      // Clicking the dimmed backdrop closes the modal too.
      modal.addEventListener("click", function (e) {
        if (e.target === modal) modal.close();
      });

      var fromRedirect = new URLSearchParams(location.search).get("status");
      if (fromRedirect) {
        show(fromRedirect);
        history.replaceState(null, "", location.pathname);
      }

      // View transitions re-run this on every navigation; bind only once per form.
      if (form.dataset.bound) return;
      form.dataset.bound = "1";

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        var button = form.querySelector("button[type=submit], button:not([type])");
        if (button) button.disabled = true;

        fetch(form.action, { method: "POST", body: new FormData(form) })
          .then(function (res) {
            var status = new URL(res.url).searchParams.get("status");
            if (status === "success") form.reset();
            show(status || "error");
          })
          .catch(function () {
            show("error");
          })
          .finally(function () {
            if (button) button.disabled = false;
          });
      });
    }

    // Inline scripts re-run on view-transition navigations; register once.
    if (window.__contactModalBound) return;
    window.__contactModalBound = true;
    document.addEventListener("astro:page-load", init);
  })();
</script>
