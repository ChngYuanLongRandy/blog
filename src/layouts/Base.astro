---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

// font families - extract font names for Font component (filter out type keys)
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  type?: "website" | "article";
  date?: Date;
}

// distructure frontmatters
const {
  title,
  meta_title,
  description,
  image,
  noindex,
  canonical,
  type = "website",
  date,
} = Astro.props;

// SEO values shared by the canonical link, Open Graph, Twitter and JSON-LD
const siteUrl = config.site.base_url.replace(/\/$/, "");
const pageTitle = plainify(
  meta_title ? meta_title : title ? title : config.site.title,
).trim();
const pageDescription = plainify(
  description ? description : config.metadata.meta_description,
).trim();
const canonicalUrl =
  canonical ?? `${siteUrl}${Astro.url.pathname.replace(/\/$/, "")}`;
const imagePath = image ? image : config.metadata.meta_image;
const imageUrl = imagePath.startsWith("http")
  ? imagePath
  : `${siteUrl}${imagePath}`;

const jsonLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: pageTitle,
        description: pageDescription,
        image: imageUrl,
        datePublished: date?.toISOString(),
        author: { "@type": "Person", name: config.metadata.meta_author },
        mainEntityOfPage: canonicalUrl,
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: config.site.title,
        url: siteUrl,
        author: { "@type": "Person", name: config.metadata.meta_author },
      };
---

<!doctype html>
<html lang="en">
  <head>
    <!-- dark mode: applied before paint (and re-applied after every
         ClientRouter transition, since navigation can reset the class) -->
    <script is:inline>
      (function () {
        function applyTheme() {
          var stored = localStorage.getItem("theme");
          document.documentElement.classList.toggle("dark", stored !== "light");
        }
        applyTheme();
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>
    <!-- Google Analytics (GA4): production only, so local dev doesn't pollute
         the stats. Navigation page views come from GA4's history tracking. -->
    {
      import.meta.env.PROD && config.google_analytics.measurement_id && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${config.google_analytics.measurement_id}`}
          />
          <script
            is:inline
            define:vars={{ id: config.google_analytics.measurement_id }}
          >
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", id);
          </script>
        </>
      )
    }
    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <!-- theme meta -->
    <meta name="theme-name" content="bookworm-light-astro" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- google font css - Astro 6 built-in Font API -->
    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>{pageTitle}</title>

    <!-- canonical url (always set, so duplicates like vercel.app preview
         domains point search engines at the real site) -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta name="description" content={pageDescription} />

    <ClientRouter />

    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- open graph -->
    <meta property="og:site_name" content={config.site.title} />
    <meta property="og:locale" content="en_SG" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    {
      type === "article" && date && (
        <meta property="article:published_time" content={date.toISOString()} />
      )
    }

    <!-- twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <TwSizeIndicator />
    <Header />
    <main id="main-content" class="min-h-[60vh] pt-8 md:pt-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>
